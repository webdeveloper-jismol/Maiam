@{
    var crumbs = new[] { new Breadcrumb("About Us", "/about-maiam/"), new Breadcrumb("About MAIAM") };
    ViewData.SetPageMeta(new PageMeta
    {
        Title = "About Manappuram Institute of Automotive Skills",
        Description = "MAIAM, established in 2019, is part of Manappuram Foundation and Kerala’s 1st central government approved, ASDC accredited Automotive Body Repair institution.",
        Path = "/about-maiam/",
        OgImage = "/assets/images/og/about.jpg",
        Breadcrumbs = crumbs,
    });
    ViewData["BodyClass"] = "page-about";
    var hero = new PageHeroModel(
        Title: "About MAIAM",
        Lead: "Manappuram Institute of Automotive Skills (MAIAM), established under the aegis of Manappuram Foundation, is committed to developing a skilled and industry-ready automotive workforce.",
        ImageKey: "campus/campus-pathway",
        Breadcrumbs: crumbs,
        Eyebrow: "Established in 2019");
}
@section Styles {
    <link rel="stylesheet" href="~/css/about-maiam.css" asp-append-version="true" />
}

<partial name="_PageHero" model="hero" />

<!-- Introduction -->
<section class="section" aria-labelledby="about-intro-title">
    <div class="container split split--wide-text">
        <div data-reveal>
            <p class="eyebrow">MAIAM established in 2019</p>
            <h2 id="about-intro-title">Developing Skilled Professionals for the Automotive Body Repair Industry</h2>
            <div class="prose">
                <p>
                    Manappuram Institute of Automotive Skills (MAIAM) is an initiative of Manappuram Foundation, 
                    the Corporate Social Responsibility (CSR) arm of Manappuram Finance Ltd. 
                    Established with a vision to strengthen the automotive skill development ecosystem, 
                    MAIAM is committed to nurturing skilled, competent and industry-ready automotive professionals.
                </p>
                <p>
                    MAIAM is among Kerala's pioneering institutions in automotive body repair training, 
                    recognised as a Central Government-approved and Automotive Skills Development Council (ASDC)-accredited training 
                    institution.
                </p>
                <p>
                    The automotive body repair industry faces a growing demand for technically competent entry-level professionals. 
                    Recognising this industry need, MAIAM focuses on bridging the skill gap by developing a consistent pipeline of trained 
                    technicians equipped with the practical knowledge and technical competencies required by the industry.
                </p>
                <p>
                    With state-of-the-art training infrastructure, industry-oriented training methodologies, 
                    modern practical facilities and experienced trainers, MAIAM delivers comprehensive, hands-on learning experiences. 
                    Our training approach combines technical knowledge with extensive practical exposure to ensure that candidates 
                    are well-prepared to meet real-world industry requirements.
                </p>

                <p class="statement">
                    At MAIAM, our commitment goes beyond training — we strive to build a skilled workforce,
                    strengthen industry partnerships and create sustainable career opportunities in the automotive sector.
                </p>
            </div>
        </div>
        <div class="about-intro__media" data-reveal>
            <div class="media-frame">
                <maiam-img key="campus/campus-entrance-building" sizes="(min-width: 960px) 42vw, 92vw" />
            </div>
        </div>
    </div>
</section>

<!-- Key facts -->
<section class="about-facts" aria-label="MAIAM at a glance">
    <div class="container">
        <dl class="about-facts__grid">
            <div class="about-fact">
                <dt>Established</dt>
                <dd><strong>@SiteInfo.EstablishedYear</strong></dd>
            </div>
            <div class="about-fact">
                <dt>Managed by</dt>
                <dd><strong>Manappuram Foundation</strong> CSR Body of Manappuram Finance Ltd.</dd>
            </div>
            <div class="about-fact">
                <dt>Recognition</dt>
                <dd><strong>1st in Kerala</strong> Central government approved, ASDC accredited – Automotive Body Repair</dd>
            </div>
            <div class="about-fact">
                <dt>Campus</dt>
                <dd><strong>Painoor, Valapad</strong> Thrissur, Kerala – near Kanoli Canal</dd>
            </div>
        </dl>
    </div>
</section>

<!-- Who we are (merged from the original /who-we-are/ page) -->
<section class="section section--light" id="who-we-are" aria-labelledby="who-we-are-title">
    <div class="container split split--reverse">
        <div data-reveal>
            <!--<p class="eyebrow">Who We Are</p>-->
            <h2 id="who-we-are-title">Empowering Aspirations. Building Automotive Careers.</h2>
            <div class="prose">
                <p>
                    Manappuram Institute of Automotive Skills (MAIAM) is an initiative of Manappuram Foundation, 
                    the Corporate Social Responsibility (CSR) arm of Manappuram Finance Ltd. 
                    Established with a commitment to excellence in technical education and vocational training, 
                    MAIAM is among Kerala's pioneering institutions dedicated to specialised automotive body repair training.
                </p>
                <p>
                    The automotive sector offers significant opportunities for skilled professionals, 
                    driven by continuous technological advancements and the growing demand for qualified technicians. 
                    At MAIAM, we aim to bridge the gap between industry requirements and workforce capabilities by equipping 
                    aspiring individuals with relevant technical knowledge, practical expertise and industry-ready competencies.
                </p>
                <p>
                    Our focus is on continuously enhancing automotive skills through structured training programmes, 
                    modern technologies and industry-aligned learning methodologies. 
                    We believe that skill development is a powerful catalyst for individual empowerment, 
                    economic growth and employment generation.
                </p>
                <p>
                    Supported by modern training infrastructure, well-designed training methodologies and experienced trainers, 
                    MAIAM is committed to developing a consistent pipeline of skilled and qualified technicians to meet the 
                    evolving needs of the automotive industry.
                </p>
                <p class="statement">
                    Our mission extends beyond imparting technical skills — we strive to transform aspirations into professional
                    capabilities, create sustainable career opportunities and contribute to the growth of India's automotive workforce.
                </p>
            </div>
        </div>
        <div class="about-duo" data-reveal>
            <maiam-img key="workshops/students-tool-selection" class="about-duo__a" sizes="(min-width: 960px) 22vw, 46vw" />
            <maiam-img key="workshops/student-workbench" class="about-duo__b" sizes="(min-width: 960px) 22vw, 46vw" />
        </div>
    </div>
</section>

<!-- Explore -->
<section class="section section--dark" aria-labelledby="about-explore-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow eyebrow--light">Explore MAIAM</p>
            <h2 id="about-explore-title">More about the institute</h2>
        </div>
        <div class="grid grid--4">
            <a class="about-link" href="/objectives/">
                <svg class="icon" aria-hidden="true"><use href="#i-target"></use></svg>
                <span>Objectives</span>
            </a>
            <a class="about-link" href="/vision-and-mission/">
                <svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg>
                <span>Vision and Mission</span>
            </a>
            <a class="about-link" href="/our-facilities/">
                <svg class="icon" aria-hidden="true"><use href="#i-building"></use></svg>
                <span>Our Facilities</span>
            </a>
            <a class="about-link" href="/faculties/">
                <svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg>
                <span>Faculties</span>
            </a>
        </div>
    </div>
</section>

<partial name="_EnquiryCTA" />

@section Scripts {
    <script src="~/js/about-maiam.js" asp-append-version="true" defer></script>
}
