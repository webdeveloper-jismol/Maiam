@{
    var crumbs = new[] { new Breadcrumb("Courses"), new Breadcrumb("Automotive Body Repair Technician") };
    const string summary = "One-year ASDC, NSDC & NCVET certified Automotive Body Repair Technician course in Thrissur: 8 months institutional training + 4 months dealership internship.";
    ViewData.SetPageMeta(new PageMeta
    {
        Title = "Automotive Body Repair Technician Course, Thrissur",
        Description = summary,
        Path = "/courses/",
        OgImage = "/assets/images/og/automotive-body-repair.jpg",
        Breadcrumbs = crumbs,
        StructuredData =
        [
            StructuredData.Course("Automotive Body Repair Technician", summary, "/courses/", "P1Y",
                "ASDC (Automotive Skill Development Council), NSDC & NCVET certification"),
        ],
    });
    ViewData["BodyClass"] = "page-course page-abr";
    var hero = new PageHeroModel(
        Title: "Automotive Body Repair Technician",
        Lead: "Learn to repair the body and frame of vehicles damaged by major and minor dents – a one-year central government certified course with internship training in dealerships.",
        ImageKey: "automotive-body-repair/bumper-heat-repair",
        Breadcrumbs: crumbs,
        Eyebrow: "Course · Model curriculum: Automotive Body Technician");
    var practical = new[]
    {
        "automotive-body-repair/students-door-panel",
        "automotive-body-repair/panel-inspection-students",
        "automotive-body-repair/sheet-metal-bench",
        "automotive-body-repair/bench-grinding",
        "automotive-body-repair/door-inspection",
        "workshops/students-repair-bay",
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/automotive-body-repair.css" asp-append-version="true" />
}

<partial name="_PageHero" model="hero" />

<!-- Key facts -->
<section class="course-facts" aria-label="Course facts">
    <div class="container">
        <dl class="fact-grid">
            <div class="fact">
                <dt><svg class="icon" aria-hidden="true"><use href="#i-award"></use></svg>Certification</dt>
                <dd>ASDC, NSDC &amp; NCVET (central government certification)</dd>
            </div>
            <div class="fact">
                <dt><svg class="icon" aria-hidden="true"><use href="#i-calendar"></use></svg>Duration</dt>
                <dd>1 Year: 8 months institutional training + 4 months internship</dd>
            </div>
            <div class="fact">
                <dt><svg class="icon" aria-hidden="true"><use href="#i-cap"></use></svg>Qualification</dt>
                <dd>SSLC or Plus Two</dd>
            </div>
            <div class="fact">
                <dt><svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg>Batch size</dt>
                <dd>Maximum 25 students per batch</dd>
            </div>
            <div class="fact">
                <dt><svg class="icon" aria-hidden="true"><use href="#i-briefcase"></use></svg>Placement</dt>
                <dd>100% placement assistance</dd>
            </div>
        </dl>
    </div>
</section>

<!-- About the course -->
<section class="section" aria-labelledby="abr-about-title">
    <div class="container split split--wide-text">
        <div>
            <p class="eyebrow">About the course</p>
            <h2 id="abr-about-title">Build Technical Expertise. Develop Practical Skills. Shape Your Automotive Career</h2>
            <div class="prose">
                <p>
                    An Automotive Body Repair Technician is a skilled professional responsible for inspecting, 
                    assessing and repairing damaged vehicle body structures and components resulting from minor or major collisions, 
                    dents and other forms of physical damage.
                </p>
                <p>
                    This programme is designed to develop the technical knowledge and practical competencies required to perform 
                    automotive body repair operations using appropriate tools, equipment and industry-standard techniques. 
                    Through hands-on training and structured practical learning, trainees gain the skills necessary to restore damaged 
                    vehicle body components to their required condition while following workplace safety and quality standards.
                </p>
                <p>The course is aligned with the Automotive Body Repair Technician  Model Curriculum prescribed by the Automotive 
                    Skills Development Council (ASDC), ensuring industry-relevant training and occupational competencies.</p>
            </div>
        </div>
        <div class="media-frame">
            <maiam-img key="automotive-body-repair/sheet-metal-marking" sizes="(min-width: 960px) 40vw, 92vw" />
        </div>
    </div>
</section>

<!-- Eligibility & career progression -->
<section class="section section--light" aria-labelledby="abr-pathway-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Admission &amp; careers</p>
            <h2 id="abr-pathway-title">Who can join, and where it leads</h2>
        </div>
        <div class="abr-pathway">
            <article class="abr-pathway__card">
                <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-cap"></use></svg></span>
                <h3>Eligibility Criteria</h3>
                <ul class="check-list">
                    <li>Minimum educational qualification: 10th Standard pass.</li>
                    <li>Minimum age for entry: 18 years.</li>
                </ul>
            </article>
            <article class="abr-pathway__card">
                <span class="icon-badge icon-badge--accent"><svg class="icon" aria-hidden="true"><use href="#i-briefcase"></use></svg></span>
                <h3>Career Progression</h3>
                <p>Successful trainees can explore employment opportunities in:</p>
                <ul class="abr-pathway__workplaces">
                    <li>Automobile dealerships</li>
                    <li>Authorised service centres</li>
                    <li>Multi-brand workshops</li>
                    <li>Vehicle body repair facilities</li>
                    <li>Automotive collision repair units</li>
                </ul>
                <p class="abr-pathway__note">
                    They can also pursue further training and higher-level qualifications while gaining professional
                    experience, enabling continuous career advancement in the automotive industry.
                </p>
            </article>
        </div>
    </div>
</section>

<!-- Course structure -->
<section class="section section--dark" aria-labelledby="abr-structure-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow eyebrow--light">Course structure</p>
            <h2 id="abr-structure-title">From workshop training to the dealership floor</h2>
        </div>
        <ol class="course-timeline">
            <li class="course-step">
                <span class="course-step__marker">8<small>months</small></span>
                <h3>Institutional training</h3>
                <p>Theory and hands-on practice at MAIAM, with pneumatics, electric tools and the latest equipment.</p>
            </li>
            <li class="course-step">
                <span class="course-step__marker">4<small>months</small></span>
                <h3>Internship training</h3>
                <p>Internship training in various automotive dealership workshops.</p>
            </li>
            <li class="course-step">
                <span class="course-step__marker"><svg class="icon" aria-hidden="true"><use href="#i-shield"></use></svg></span>
                <h3>Assessment &amp; certification</h3>
                <p>Assessment is conducted by the Automotive Skill Development Council (ASDC) – ASDC, NSDC &amp; NCVET certification.</p>
            </li>
            <li class="course-step">
                <span class="course-step__marker"><svg class="icon" aria-hidden="true"><use href="#i-briefcase"></use></svg></span>
                <h3>Placement assistance</h3>
                <p>After successful completion, trainees are supported with placement in reputed firms.</p>
            </li>
        </ol>
    </div>
</section>

<!-- Curriculum document -->
<section class="section" aria-labelledby="abr-curriculum-title">
    <div class="container">
        <div class="qp-card">
            <span class="qp-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-file"></use></svg></span>
            <div class="qp-card__text">
                <p class="eyebrow">Model curriculum</p>
                <h2 id="abr-curriculum-title" class="qp-card__title">Qualification Pack – Auto Body Repair Technician</h2>
                <p>The qualification pack published by the Automotive Skill Development Council sets out the job role, standards and assessment criteria for this course.</p>
            </div>
            <a class="btn btn--primary qp-card__btn" href="/assets/documents/qp-automotive-body-repair-technician.pdf" target="_blank" rel="noopener" type="application/pdf">
                <svg class="icon" aria-hidden="true"><use href="#i-download"></use></svg>
                View PDF <span class="qp-card__size">(1.3 MB)</span>
            </a>
        </div>
    </div>
</section>

<!-- Practical training -->
<section class="section section--light" aria-labelledby="abr-practical-title">
    <div class="container">
        <div class="section-head section-head--row">
            <div>
                <p class="eyebrow">Practical training</p>
                <h2 id="abr-practical-title">Inside the body repair workshop</h2>
                <!--<p class="lead">Photographs from MAIAM’s workshop at Painoor, Valapad.</p>-->
            </div>
            <a class="link-arrow" href="/our-facilities/">Our facilities <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
        </div>
        <div class="course-gallery">
            @foreach (var key in practical)
            {
                var image = ImageCatalog.Get(key);
                <a class="image-tile" href="@image.LargestUrl" data-lightbox="abr-practical">
                    <maiam-img key="@key" sizes="(min-width: 960px) 30vw, 46vw" />
                    <span class="image-tile__zoom" aria-hidden="true"><svg class="icon"><use href="#i-expand"></use></svg></span>
                </a>
            }
        </div>
    </div>
</section>

<!-- Why this skill -->
<section class="section" aria-labelledby="abr-why-title">
    <div class="container split">
        <div>
            <!--<p class="eyebrow">Why automotive body repair</p>-->
            <h2 id="abr-why-title">
                The Expertise behind Vehicle Restoration and Collision Repair
            </h2>
            <div class="prose">
                <p>
                    The automotive industry is undergoing a major transformation driven by technological advancements, 
                    vehicle electrification and evolving mobility solutions. As the industry continues to grow, 
                    the demand for skilled and qualified automotive professionals remains essential.
                </p>
                <p>
                    Regardless of whether a vehicle is powered by petrol, diesel, electricity or hybrid technology, 
                    its body structure remains a critical component. Accidents, collisions, dents, 
                    corrosion and structural damage make professional body repair an essential part of vehicle maintenance and 
                    restoration.
                </p>
                <p>
                    Automotive Body Repair Technicians play a vital role in restoring damaged vehicles through specialised repair 
                    techniques, modern equipment and precision workmanship. From minor dent removal to major structural repairs, 
                    their expertise helps restore vehicle appearance, structural integrity and safety in accordance with manufacturer 
                    specifications.
                </p>
                <p>
                    With the continuous expansion of the global automotive industry, automotive body repair offers opportunities for 
                    skilled professionals across authorised dealerships, multi-brand service centres, independent workshops and 
                    specialised collision repair facilities.
                </p>
                <p>
                    Technology may transform the automobile, but the need for skilled professionals to repair and restore vehicles 
                    remains. Automotive Body Repair is a skill with lasting relevance and promising career opportunities.
                </p>
            </div>
        </div>
        <div class="abr-asdc">
            <h3>Strengthening India's Automotive Skills Ecosystem</h3>
            <p>
                The Automotive Skills Development Council (ASDC) is India's sector-specific skill development council 
                for the automotive industry. It is an industry-led initiative promoted by the Society of Indian Automobile
                Manufacturers (SIAM), Automotive Component Manufacturers Association of India (ACMA) and Federation of Automobile 
                Dealers Associations (FADA), with support from the Government of India and the National Skill Development Corporation
                (NSDC).
            </p>
            <p>ASDC works towards developing a skilled, competent and industry-ready workforce by aligning skill development programmes
                with the evolving requirements of the automotive sector. Through industry-driven occupational standards, structured 
                training frameworks and recognised qualification pathways, ASDC aims to bridge the gap between industry skill 
                requirements and workforce capabilities.</p>
            <p>Its initiatives focus on enhancing employability, promoting technical excellence and ensuring that India's automotive 
                workforce is equipped to meet emerging technological advancements and changing industry demands.</p>
            <a class="link-arrow" href="/certificate-of-affiliation/">MAIAM’s ASDC affiliation <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
        </div>
    </div>
</section>

<!-- Scholarships -->
<section class="section section--blue" aria-labelledby="abr-scholarship-title">
    <div class="container abr-scholarship">
        <div>
            <p class="eyebrow">Scholarships</p>
            <h2 id="abr-scholarship-title">Scholarships for this course</h2>
            <p class="text-muted">Available only for the Automotive Body Repair Technician course.</p>
        </div>
        <ul class="abr-scholarship__list">
            <li><strong>10%</strong> Scholarship for BPL students</li>
            <li><strong>5%</strong> Scholarship for APL backward students</li>
        </ul>
        <div class="notice abr-scholarship__notice">
            <svg class="icon" aria-hidden="true"><use href="#i-file"></use></svg>
            <p>Eligibility conditions apply. Please contact MAIAM to confirm current scholarship availability before applying.</p>
        </div>
    </div>
</section>

<!-- Course videos -->
<section class="section section--dark" aria-labelledby="abr-videos-title">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow eyebrow--light">Course videos</p>
            <h2 id="abr-videos-title">Auto Body Technician training at MAIAM</h2>
        </div>
        <div class="abr-videos">
            <figure class="abr-videos__main">
                <div class="native-video">
                    <video controls preload="none" playsinline poster="/assets/images/posters/maiam-brand-film.webp" aria-label="Auto Body Technician course film">
                        <source src="/assets/videos/maiam-brand-film.mp4" type="video/mp4" />
                        <a href="/assets/videos/maiam-brand-film.mp4">Download the Auto Body Technician course film</a>
                    </video>
                </div>
                <figcaption class="video-embed__caption">Auto Body Technician – course film</figcaption>
            </figure>
            <div class="abr-videos__intro">
                <h3>Watch the course films</h3>
                <p>See students training for the Auto Body Technician course, with more films from Manappuram Foundation’s YouTube channel below.</p>
                <a class="btn btn--ghost-light" href="/register-now/">Enquire about this course</a>
            </div>
            @{
                var courseVideos = SiteContent.GalleryVideos.Where(v => v.Title.Contains("Body Technician")).ToList();
            }
            @foreach (var video in courseVideos)
            {
                // Two films share one YouTube title; number them so each has a distinct name.
                var sameTitle = courseVideos.Where(v => v.Title == video.Title).ToList();
                var title = sameTitle.Count > 1 ? $"{video.Title} – Part {sameTitle.IndexOf(video) + 1}" : video.Title;
                <partial name="_VideoEmbed" model="new VideoEmbedModel(video.YouTubeId, title, Compact: true)" />
            }
        </div>
    </div>
</section>

<partial name="_RelatedCourses" model="@("/courses/")" />

<partial name="_EnquiryCTA" />

@section Scripts {
    <script src="~/js/automotive-body-repair.js" asp-append-version="true" defer></script>
}
