@model VisionMissionViewModel
@{
    Layout = "_Layout";
}

<!-- Page Hero -->
<section class="page-hero">
    <div class="container-page">
        <p class="section-tag">About Us</p>
        <h1>Vision &amp; Mission</h1>
    </div>
</section>

<!-- Vision & Mission -->
<section class="section">
    <div class="container-page split-grid">
        <div class="split-card" data-reveal>
            <h3>Our Vision</h3>
            <p>
                To be the leading automotive skills training institute in India, recognized for producing world-class
                technicians who meet global industry standards. We envision a future where every student trained at
                MAIAM becomes a catalyst for innovation and excellence in the automotive sector.
            </p>
        </div>
        <div class="split-card" data-reveal>
            <h3>Our Mission</h3>
            <p>
                To provide accessible, high-quality automotive and welding skills training that empowers students from
                all backgrounds to build successful careers. Through industry partnerships, experienced faculty, and
                state-of-the-art facilities, we are committed to bridging the skill gap and contributing to India's
                automotive excellence.
            </p>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="section" style="background-color:var(--color-bg-light);">
    <div class="container-page">
        <p class="section-tag">Principles</p>
        <h2 class="section-title">Our Core Values</h2>
        <div class="grid-cards grid-cards-3" style="margin-top:40px;">
            @foreach (var v in Model.CoreValues)
            {
                <div class="card-maiam" data-reveal>
                    <div class="card-icon">@await Html.PartialAsync("_IconSvg", v.IconKey)</div>
                    <h3 style="font-size:1.15rem; margin-bottom:10px;">@v.Title</h3>
                    <p>@v.Description</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-band">
    <div class="container-page">
        <p class="section-tag" style="justify-content:center; color:#f87171;">Join Our Mission</p>
        <h2 class="section-title">Be part of an institute that is transforming automotive education in Kerala.</h2>
        <a class="btn-maiam btn-maiam-primary" asp-controller="Contact" asp-action="Index">Enquire Now</a>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/about.css" asp-append-version="true" />
}
