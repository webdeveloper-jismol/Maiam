@model GalleryViewModel
@{
    Layout = "_Layout";
}

<!-- Page Hero -->
<section class="page-hero">
    <div class="container-page">
        <p class="section-tag">Visuals</p>
        <h1>Gallery</h1>
    </div>
</section>

<!-- Gallery Sections -->
<section class="section">
    <div class="container-page">
        <p class="section-tag">Memories</p>
        <h2 class="section-title">Campus Moments</h2>
        <p class="section-subtitle" style="margin-bottom:40px;">
            Glimpses of our events, workshops, training sessions, and campus life.
        </p>

        @foreach (var gallerySection in Model.Sections)
        {
            <!-- Gallery section: @gallerySection.Heading -->
            <!-- data-reveal is applied per thumbnail (not on this whole, possibly very tall, section wrapper) -->
            <!-- so the scroll-reveal threshold is met immediately instead of requiring 15% of an entire -->
            <!-- multi-image section to be on-screen at once, which large sections could never satisfy. -->
            <div class="gallery-section">
                <h3 class="gallery-section__heading">@gallerySection.Heading</h3>
                <div class="gallery-section__grid">
                    @foreach (var image in gallerySection.Images)
                    {
                        <button type="button" class="gallery-section__item" data-reveal data-lightbox-src="@image.Url" data-lightbox-alt="@image.Alt">
                            <img src="@image.Url" alt="@image.Alt" loading="lazy" />
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Lightbox overlay (shared across all gallery sections) -->
<div class="lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Image preview">
    <button type="button" class="lightbox__close" id="lightboxClose" aria-label="Close preview">&times;</button>
    <button type="button" class="lightbox__arrow lightbox__arrow--prev" id="lightboxPrev" aria-label="Previous image">&#8592;</button>
    <img class="lightbox__image" id="lightboxImage" src="" alt="" />
    <button type="button" class="lightbox__arrow lightbox__arrow--next" id="lightboxNext" aria-label="Next image">&#8594;</button>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/gallery.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/gallery.js" asp-append-version="true"></script>
}
